[Unit]
Description=Meshcrap Meshtastic receiver collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=meshcrap
WorkingDirectory=/opt/meshcrap
ExecStart=/opt/meshcrap/.venv/bin/python /opt/meshcrap/meshcrap.py --config /opt/meshcrap/config.json collect
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=78
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
