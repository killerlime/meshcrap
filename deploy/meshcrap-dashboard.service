[Unit]
Description=Meshcrap private dashboard
After=network.target

[Service]
Type=simple
User=meshcrap
WorkingDirectory=/opt/meshcrap
ExecStart=/opt/meshcrap/.venv/bin/python /opt/meshcrap/meshcrap.py --config /opt/meshcrap/config.json serve
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
